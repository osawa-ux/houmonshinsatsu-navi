#!/bin/bash
# ポータル中立性チェック: blog/ guide/ の変更時に禁止語を検査
CHANGED=$(git diff --cached --name-only | grep -E '^(blog/|guide/)' | head -1)
if [ -n "$CHANGED" ]; then
  CHECK_SCRIPT="$HOME/MyPython/check_neutrality.py"
  if [ ! -f "$CHECK_SCRIPT" ]; then
    echo "[pre-commit] WARNING: $CHECK_SCRIPT not found. Skipping local neutrality check. CI will validate on push." 1>&2
    exit 0
  fi
  echo "[pre-commit] blog/guide の変更を検出 — 中立性チェック実行中..."
  python3 "$CHECK_SCRIPT" --site "$(git rev-parse --show-toplevel)"
  if [ $? -ne 0 ]; then
    echo "[pre-commit] 禁止語が検出されました。修正してから再コミットしてください。"
    exit 1
  fi
  echo "[pre-commit] 中立性チェック合格"
fi
