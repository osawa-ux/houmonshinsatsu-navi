#!/bin/bash
# zaitakuclinic-navi SEO regression test hook
# 都道府県名削除等の partial rollback を push 前に検知する
#
# bypass: SEO_REGRESSION_SKIP=1 git push
#
# fail-close 方針 (2026-06-03 / 2026-08-19 改訂):
#   旧実装は単一 hardcode path ($HOME/MyPython/audit_seo.py) を見て不在なら通過して
#   いたため、MyPython の配置が変わると SEO regression check が黙って skip されたまま
#   push が成功していた (本 hook の存在意義が無効化されていた)。
#   path candidate 探索 + python/python3 fallback は repo の pre-commit hook
#   (tools/hooks/pre-commit) と同じパターンを踏襲する。
#
#   止める条件と止めない条件を分ける (2026-08-19):
#     - MyPython ディレクトリ自体が無い   -> skip (exit 0)。正常な構成差であり、
#       ここで止めると hotfix push が毎回赤くなり SEO_REGRESSION_SKIP=1 が常態化して
#       実質 fail-open へ退行する。判定子は **ディレクトリの有無** で、
#       audit_seo.py の有無ではない (下記の 1 つ下の条件と区別する)。
#     - MyPython はあるが audit_seo.py が無い -> FAIL (exit 1)。改名・移動・削除。
#     - MyPython はあるが site/ が無い     -> FAIL (exit 1)。真の設定不備 (未 build)。
#     - Python3 が PATH に無い             -> FAIL (exit 1)。検査を実行できない。
#     - audit が regression を検知         -> FAIL (exit 1)。

if [ "${SEO_REGRESSION_SKIP:-0}" = "1" ]; then
  echo "[pre-push] SEO regression check skipped (SEO_REGRESSION_SKIP=1)"
  exit 0
fi

# --- audit_seo.py の候補 path 探索 ---
# MyPython の配置は PC により ~/projects/MyPython または ~/MyPython。
# 見つかった最初の audit_seo.py を採用する。
# (audit_seo.py は自身の dir 基準で site/ を BASE/"site" として self-locate するため、
#  ここでは script の発見のみ行えばよい)
AUDIT_CANDIDATES=(
  "$HOME/projects/MyPython/audit_seo.py"
  "$HOME/MyPython/audit_seo.py"
)

AUDIT_SCRIPT=""
for c in "${AUDIT_CANDIDATES[@]}"; do
  if [ -f "$c" ]; then
    AUDIT_SCRIPT="$c"
    break
  fi
done

# skip の判定子は「MyPython ディレクトリの有無」であって audit_seo.py の有無ではない。
#   ファイルの有無で skip を決めると、MyPython はあるのに script が改名・移動・削除された
#   ケースまで skip に落ち、2026-06-03 に fail-close 化した動機そのもの
#   (「配置が変わると黙って skip される」) を作り直してしまう (2026-08-19 xrev C-1)。
MYPY_DIRS=(
  "$HOME/projects/MyPython"
  "$HOME/MyPython"
)
MYPY_DIR_FOUND=""
for d in "${MYPY_DIRS[@]}"; do
  if [ -d "$d" ]; then
    MYPY_DIR_FOUND="$d"
    break
  fi
done

if [ -z "$AUDIT_SCRIPT" ] && [ -n "$MYPY_DIR_FOUND" ]; then
  echo ""
  echo "[pre-push] FAIL: MyPython ($MYPY_DIR_FOUND) はあるのに audit_seo.py が見つかりません。"
  echo "[pre-push]   探索した候補:"
  for c in "${AUDIT_CANDIDATES[@]}"; do
    echo "[pre-push]     - $c"
  done
  echo "[pre-push]   改名・移動・削除の可能性があります。ここで skip すると SEO regression を"
  echo "[pre-push]   黙って見逃すため止めます。"
  echo "[pre-push]   bypass (検査不要が確実な場合のみ): SEO_REGRESSION_SKIP=1 git push origin <branch>"
  exit 1
fi

if [ -z "$AUDIT_SCRIPT" ]; then
  # MyPython 自体を持たない PC は「正常な構成差」なので skip する (2026-08-19 決定)。
  #   ここを exit 1 にすると、MyPython を持たない PC からの hotfix push が毎回止まり、
  #   回避に SEO_REGRESSION_SKIP=1 が常態化する。同 bypass は本物の regression 検査も
  #   同時に無効化するため、「常時赤 -> bypass 常態化 -> 実質 fail-open」へ退行する。
  #   一方 "MyPython はあるのに site/ が無い" "Python3 が無い" は真の設定不備なので
  #   下で fail-close のまま止める (この 2 つとは区別する)。
  echo "[pre-push] SKIP: audit_seo.py がどの候補 path にも見つかりません。"
  for c in "${AUDIT_CANDIDATES[@]}"; do
    echo "[pre-push]   - $c"
  done
  echo "[pre-push]   この PC に MyPython が無い構成とみなし SEO regression check を skip します。"
  echo "[pre-push]   MyPython を持つ PC では skip されません (site/ 未 build や Python3 不在は止めます)。"
  exit 0
fi

# python 実行コマンドの解決 (python -> python3 の順。Windows の python3 MS Store
# リダイレクト対策として、まず python が Python 3 かを確認する)
PYTHON_BIN=""
if command -v python >/dev/null 2>&1 && python -c "import sys; sys.exit(0 if sys.version_info[0]==3 else 1)" >/dev/null 2>&1; then
  PYTHON_BIN="python"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="python3"
fi
if [ -z "$PYTHON_BIN" ]; then
  echo "[pre-push] FAIL: Python 3 が PATH 上に見つかりません。SEO regression check を実行できません。"
  echo "[pre-push]   bypass (検査不要が確実な場合のみ): SEO_REGRESSION_SKIP=1 git push origin <branch>"
  exit 1
fi

# site/ は audit_seo.py が script dir 基準で self-locate する。
# script と同階層に site/ が無い状態を分かりやすく止める。
AUDIT_DIR="$(dirname "$AUDIT_SCRIPT")"
SITE_DIR="$AUDIT_DIR/site"
if [ ! -d "$SITE_DIR" ]; then
  echo ""
  echo "[pre-push] FAIL: build 出力 site/ が見つかりません: $SITE_DIR"
  echo "[pre-push]   build されていない状態では SEO regression check を実行できません。"
  echo "[pre-push]   対応: $AUDIT_DIR で python build_site.py を実行してから push してください。"
  echo "[pre-push]   bypass (検査不要が確実な場合のみ): SEO_REGRESSION_SKIP=1 git push origin <branch>"
  exit 1
fi

echo "[pre-push] SEO regression check 実行中... ($AUDIT_SCRIPT)"
"$PYTHON_BIN" "$AUDIT_SCRIPT" --strict
RC=$?

if [ $RC -ne 0 ]; then
  echo ""
  echo "[pre-push] FAIL: SEO regression 検知。push を中断します。"
  echo "[pre-push]   対応: 都道府県名・件数・サイト名の欠落がないか build を確認"
  echo "[pre-push]   bypass: SEO_REGRESSION_SKIP=1 git push origin <branch>"
  exit 1
fi

echo "[pre-push] PASS: SEO regression check OK"
exit 0
